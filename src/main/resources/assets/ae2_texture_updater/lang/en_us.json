  "text.autoconfig.ae2_texture_updater.option.guiMerge": "GUI Repair Layer",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.@Tooltip": "Merge community-fixed GUI screens and textures on top of the updated textures, so GUIs stay aligned on 1.20.1",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.enabled.@PrefixText": "The 1.21 textures do not match 1.20.1 GUI layouts; using them directly not only misaligns screens but can also prevent some screens from opening at all.\nThis layer downloads a community-maintained, pre-fixed GUI resource pack and merges it in.\nOnly the GUI part (screens JSONs and the textures they reference) is used; vanilla GUI and block/item textures are untouched.",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.enabled": "Enable GUI Layer",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.enabled.@Tooltip[0]": "Download the GUI resource pack and merge it into the generated pack",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.enabled.@Tooltip[1]": "If disabled, screens may be misaligned or even fail to open, because 1.21 textures do not match 1.20.1 GUI layouts",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.source": "Download Source",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.source.@Tooltip[0]": "MODRINTH: automatically fetch the latest compatible version by project ID",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.source.@Tooltip[1]": "DIRECT_URL: download from a fixed URL you specify",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.source.enum.MODRINTH": "Modrinth (auto latest)",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.source.enum.DIRECT_URL": "Direct URL",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.modrinthProjectId": "Modrinth Project ID",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.modrinthProjectId.@Tooltip[0]": "Modrinth project ID or slug of the GUI resource pack",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.modrinthProjectId.@Tooltip[1]": "Default is AE-Light-UI Multi-module (A8nAKm0R)",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.directUrl": "Direct Download URL",
  "text.autoconfig.ae2_texture_updater.option.guiMerge.directUrl.@Tooltip": "Used when the source is DIRECT_URL. Must point to a resource pack zip",

